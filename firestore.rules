rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /chatLogs/{logId} {
      allow read, create, update, delete: if true;
    }
    match /opdLeads/{leadId} {
      allow read, create, update, delete: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
